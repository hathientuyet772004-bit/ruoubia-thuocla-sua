# ============================================================
# PROJECT CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env and fill in your values.
# ============================================================

# ── APP & ENV ───────────────────────────────────────────────
ENV=development
LOG_LEVEL=info
DEBUG=true

# ── ADMIN CENTER DATABASE (MongoDB Atlas) ───────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>
MONGODB_DB=auto_collection_data_marketing
MONGODB_TIMEOUT_MS=10000
ADMIN_AUTH_ENABLED=false
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-this-session-secret
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_PRODUCT_LOCAL_FALLBACK_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── AUTOMATION WORKER ───────────────────────────────────────
# Worker polls enabled pipelines and captures entry_urls into Mongo GridFS.
WORKER_POLL_SECONDS=60
WORKER_RUN_INTERVAL_SECONDS=300
WORKER_RUN_MANUAL_PIPELINES=false
WORKER_FETCH_TIMEOUT_SECONDS=30
WORKER_MAX_RESPONSE_BYTES=1000000
WORKER_PAGE_BUDGET=10
WORKER_MAX_PAGE_BUDGET=20
WORKER_RECRAWL_MIN_HOURS=24
WORKER_RAW_PAGE_RETENTION_DAYS=14
WORKER_MAX_RAW_PAGES_PER_DOMAIN=100

# ── WEB SECURITY ────────────────────────────────────────────────
# Comma-separated list. Use "*" only for development.
# Example: CORS_ALLOW_ORIGINS=http://localhost,http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost

# ── DOCKER PORTS ────────────────────────────────────────────────
# Docker mode keeps backend/frontend internal and publishes nginx only.
HOST_HTTP_PORT=80
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── DOCKER IMAGE PINS (khuyến nghị set ở production) ────────────
# NGINX_IMAGE=nginx:1.27-alpine
