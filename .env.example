# ============================================================
# PROJECT CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env and fill in your values.
# ============================================================

# ── APP & ENV ───────────────────────────────────────────────
ENV=development
LOG_LEVEL=info
DEBUG=true

# ── DATABASE (PostgreSQL) ───────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=collector_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ── MINIO OBJECT STORAGE ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=collector-data
MINIO_SECURE=false

# ── REDIS ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── LLM (Gemini) ───────────────────────────────────────────
GEMINI_API_KEY=YOUR_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
USE_MOCK_MODE=true

# ── LLM SAFETY / OPS ────────────────────────────────────────────
GEMINI_MAX_RETRIES=2
GEMINI_PROMPT_VERSION=2026-04-27.1
GEMINI_CACHE_TTL_DAYS=30

# ── AUTO COLLECT (Monthly) ──────────────────────────────────────
# Discover limits
COLLECT_MAX_DISCOVER_PAGES=50
COLLECT_MAX_PRODUCTS_PER_DOMAIN=2000
COLLECT_REQUEST_TIMEOUT_SEC=20

# Rate limit (random sleep between requests / page snapshots)
COLLECT_MIN_DELAY_SEC=0.5
COLLECT_MAX_DELAY_SEC=1.5

# Optional proxy rotation (comma-separated), e.g. http://user:pass@1.2.3.4:8080
PROXY_URLS=

# Airflow -> backend collect API
COLLECTOR_BACKEND_URL=http://backend:8080
COLLECT_API_TIMEOUT_SEC=3600
COLLECT_MAX_URLS_PER_DOMAIN=0

# ── WEB SECURITY ────────────────────────────────────────────────
# Comma-separated list. Use "*" only for development.
# Example: CORS_ALLOW_ORIGINS=http://localhost,http://localhost:3000
CORS_ALLOW_ORIGINS=*

# ── DOCKER IMAGE PINS (khuyến nghị set ở production) ────────────
# MINIO_IMAGE=minio/minio:<RELEASE_TAG>
# NGINX_IMAGE=nginx:1.27-alpine

# ── AIRFLOW ─────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=admin

# ── LOCAL LAKEHOUSE STORAGE ────────────────────────────────
DATABASE_PATH=data/lakehouse.db
BRONZE_DIR=data/bronze

# ── SCRAPER ────────────────────────────────────────────────
SCRAPER_TIMEOUT=20
DEFAULT_PRODUCT_LIMIT=20

# ── LOCAL SERVER ───────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=5000
