        "required": false,
        "transform": "text_content"
      },
      {
        "name": "store_phone",
        "selector": ".phone, .hotline, a[href^='tel:']",
        "attr": null,
        "required": false,
        "transform": "text_content"
      }
    ]
  },
  "stores": {
    "container_selector": ".store-list, .stores, .contact, .branches, main, body",
    "item_selector": ".store-item, .branch, .store, .contact-item, address",
