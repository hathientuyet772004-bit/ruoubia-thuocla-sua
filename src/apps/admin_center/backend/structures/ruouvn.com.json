      {
        "name": "store_name",
        "selector": ".name, h2, h3, strong",
        "attr": null,
        "required": false,
        "transform": "text_content"
      },
      {
        "name": "store_url",
        "selector": "a[href]",
        "attr": "href",
        "required": false,
        "transform": null
      },
      {
        "name": "address",
        "selector": ".address, address, .addr",
