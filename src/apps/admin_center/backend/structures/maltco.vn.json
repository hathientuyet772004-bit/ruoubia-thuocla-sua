{
  "domain": "maltco.vn",
  "page_type": "homepage",
  "listing_urls": [
    "/collections/ruou-vang-chile",
    "/collections/whisky-dau-yeu",
    "/collections/bia-nhap-khau",
    "/collections/cognac",
    "/collections/champagne-vang-sparkling"
  ],
  "listing": {
    "container_selector": ".products.wrapper, .products-grid, ol.products.list",
    "item_selector": "li.item.product.product-item",
    "pagination": {
      "type": "null",
      "next_button_selector": null,
      "page_param": null,
      "url_pattern": null,
      "max_pages": null
    },
    "fields": [
      {
        "name": "product_name",
        "selector": "a.product-item-link, .product-item-name a",
        "attr": null,
        "required": true,
        "transform": "text_content"
      },
      {
        "name": "brand",
        "selector": ".product-item-brand, .brand, [class*='brand']",
        "attr": null,
        "required": false,
        "transform": "text_content"
      },
      {
        "name": "category",
        "selector": ".product-item-category, .category, [class*='category']",
        "attr": null,
        "required": false,
        "transform": "text_content"
      },
      {
        "name": "price",
        "selector": ".price-box .price, .price-final_price .price, span.price",
        "attr": null,
        "required": true,
        "transform": "clean_price"
      },
      {
        "name": "old_price",
        "selector": ".old-price .price, .old-price, .price-old",
        "attr": null,
        "required": false,
        "transform": "clean_price"
      },
      {
        "name": "stock_status",
        "selector": ".stock, [class*='stock'], [class*='availability']",
        "attr": null,
        "required": false,
        "transform": "check_for_sold_out_indicator"
      },
      {
        "name": "rating",
        "selector": ".rating-summary, .reviews-actions, [class*='rating']",
        "attr": null,
        "required": false,
        "transform": "extract_rating_from_html_attributes_or_classes"
      },
      {
        "name": "review_count",
        "selector": ".reviews-actions, [class*='review']",
        "attr": null,
        "required": false,
        "transform": "extract_review_count_from_html_attributes_or_classes"
      },
      {
        "name": "image_url",
        "selector": "img.product-image-photo, .product-image-photo, img",
        "attr": "src",
        "required": false,
        "transform": null
      },
      {
        "name": "product_url",
        "selector": "a.product-item-link, .product-item-name a",
        "attr": "href",
        "required": true,
        "transform": null
      }
    ]
  },
  "product_detail": {
    "fields": [
      {
        "name": "product_name",
        "selector": "h1.page-title span, .product-info-main .page-title span, h1",
        "attr": null,
        "required": true,
        "transform": "text_content"
      },
      {
        "name": "brand",
        "selector": ".product-info-main .brand a, .product.attribute.brand a, [class*='brand'] a",
        "attr": null,
        "required": false,
        "transform": "text_content"
      },
      {
        "name": "category",
        "selector": ".breadcrumbs a, .product.attribute.category a",
        "attr": null,
        "required": false,
        "transform": "text_content"
      },
      {
        "name": "alcohol_percent",
        "selector": ".product.attribute.alcohol, [class*='alcohol']",
        "attr": null,
        "required": false,
        "transform": "extract_percentage"
      },
      {
        "name": "volume_ml",
        "selector": ".product.attribute.volume, [class*='volume'], [class*='dung-tich']",
        "attr": null,
        "required": false,
        "transform": "extract_volume_ml"
      },
      {
        "name": "price",
        "selector": ".product-info-main .price-box .price, .product-info-price .price, meta[itemprop='price']",
        "attr": null,
        "required": true,
        "transform": "clean_price"
      },
      {
        "name": "old_price",
        "selector": ".product-info-main .old-price .price, .old-price .price, .old-price",
        "attr": null,
        "required": false,
        "transform": "clean_price"
      },
      {
        "name": "stock_status",
        "selector": ".stock, [class*='stock'], [class*='availability']",
        "attr": null,
        "required": false,
        "transform": "check_for_sold_out_indicator"
      },
      {
        "name": "image_url",
        "selector": ".product.media img, img.product-image-photo, img",
        "attr": "src",
        "required": false,
        "transform": null
      }
    ]
  },
  "notes": "The HTML provided is from the homepage. Listing URLs were extracted from the main navigation. Product listing and detail field selectors are based on common patterns observed in e-commerce sites, assuming a similar structure for listing and detail pages.",
  "_llm_model": "gemini-2.5-flash-lite",
  "_llm_call_count": 3
}
