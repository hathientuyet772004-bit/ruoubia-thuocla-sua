  "listing": {
    "container_selector": "div.row.no-gutters.product-listing",
    "item_selector": "div.product-item",
    "pagination": {
      "type": "null",
      "next_button_selector": null,
      "page_param": null,
      "url_pattern": null,
      "max_pages": null
    },
    "fields": [
      {
        "name": "product_name",
        "selector": "div.product-item--info h3.product-item--title a",
        "attr": null,
        "required": true,
        "transform": "text_content"
      },
      {
        "name": "brand",
        "selector": "div.product-item--info div.product-item--brand",
        "attr": null,
        "required": false,
        "transform": "text_content"
      },
      {
        "name": "category",
        "selector": "div.product-item--info div.product-item--cat",
        "attr": null,
        "required": false,
        "transform": "text_content"
      },
      {
        "name": "price",
        "selector": "div.product-item--price span.price",
        "attr": null,
        "required": true,
        "transform": "clean_price"
      },
      {
        "name": "old_price",
        "selector": "div.product-item--price span.old-price",
        "attr": null,
        "required": false,
        "transform": "clean_price"
      },
      {
        "name": "stock_status",
        "selector": "div.product-item--stock",
        "attr": null,
        "required": false,
        "transform": "check_for_sold_out_indicator"
      },
      {
        "name": "rating",
        "selector": "div.product-item--vote",
        "attr": null,
        "required": false,
        "transform": "extract_rating_from_html_attributes_or_classes"
      },
      {
        "name": "review_count",
        "selector": "div.product-item--vote",
        "attr": null,
        "required": false,
        "transform": "extract_review_count_from_html_attributes_or_classes"
      },
      {
        "name": "image_url",
        "selector": "div.product-item--image img",
        "attr": "src",
        "required": false,
        "transform": null
      },
      {
        "name": "product_url",
        "selector": "div.product-item--info h3.product-item--title a",
        "attr": "href",
        "required": true,
        "transform": null
      }
    ]
  },
  "product_detail": {
    "fields": [
      {
        "name": "product_name",
        "selector": "h1.product-detail--title",
        "attr": null,
        "required": true,
