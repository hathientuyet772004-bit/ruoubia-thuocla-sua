# ============================================================
# PRODUCTION ENV EXAMPLE (.env.production)
# Run with: docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d
# ============================================================

ENV=production
LOG_LEVEL=info
DEBUG=false

# ── DATABASE (MongoDB Atlas) ────────────────────────────────
MONGODB_URI=mongodb+srv://admin:replace-with-real-password@cluster.example.mongodb.net/admin_center?appName=admin-center
MONGODB_DB=auto_collection_data_marketing
MONGODB_TIMEOUT_MS=10000
ADMIN_AUTH_ENABLED=false
ADMIN_PASSWORD=replace-with-secure-admin-password
ADMIN_SESSION_SECRET=replace-with-64-character-random-session-secret-value
ADMIN_SESSION_TTL_SECONDS=28800
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── AUTOMATION WORKER ───────────────────────────────────────
# Poll enabled pipelines and capture entry_urls into Mongo GridFS.
WORKER_POLL_SECONDS=60
WORKER_RUN_INTERVAL_SECONDS=300
WORKER_RUN_MANUAL_PIPELINES=true
WORKER_FETCH_TIMEOUT_SECONDS=30
WORKER_MAX_RESPONSE_BYTES=5000000

# ── WEB SECURITY ────────────────────────────────────────────
# Không nên dùng "*" ở production. Điền đúng domain frontend.
CORS_ALLOW_ORIGINS=https://admin.example.com

# ── DOCKER PORTS ────────────────────────────────────────────────
# Keep backend/frontend internal. Publish nginx ports only.
HOST_HTTP_PORT=80
# Enable only after SSL certificates and the 443 server block are configured.
HOST_HTTPS_PORT=443
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── PIN DOCKER IMAGES ───────────────────────────────────────
NGINX_IMAGE=nginx:1.27-alpine
