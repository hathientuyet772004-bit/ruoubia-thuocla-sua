# ============================================================
# PRODUCTION ENV EXAMPLE (.env.production)
# Run with: docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d
# ============================================================

ENV=production
LOG_LEVEL=info
DEBUG=false

# ── DATABASE (PostgreSQL) ───────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=collector_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME

# ── MINIO ───────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=collector-data
MINIO_SECURE=false

# ── REDIS ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── LLM (Gemini) ───────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-1.5-flash
USE_MOCK_MODE=false

# ── WEB SECURITY ────────────────────────────────────────────
# Không nên dùng "*" ở production. Điền đúng domain frontend.
CORS_ALLOW_ORIGINS=https://your-domain.com

# ── PIN DOCKER IMAGES ───────────────────────────────────────
# Tuyệt đối không dùng :latest ở production.
MINIO_IMAGE=minio/minio:<RELEASE_TAG>
NGINX_IMAGE=nginx:1.27-alpine

