{
  "source_file": "ruoutot.net",
  "page_type": "homepage",
  "crawl_targets": [
    {
      "entity": "products",
      "description": "List of all products displayed on the homepage, likely featured or promotional.",
      "container_selector": ".qb_flash_sale .wrap_fsale",
      "item_selector": ".item_fsale",
      "pagination": null,
      "fields": [
        {
          "name": "product_name",
          "selector": ".text_widget h3 a",
          "attr": null,
          "required": true,
          "transform": "text_content"
        },
        {
          "name": "brand",
          "selector": ".text_widget h3 a",
          "attr": null,
          "required": false,
          "transform": "extract_brand_from_product_name"
        },
        {
          "name": "category",
          "selector": ".text_widget h3 a",
          "attr": null,
          "required": false,
          "transform": "extract_category_from_product_name"
        },
        {
          "name": "alcohol_percent",
          "selector": ".ha_alcohol",
          "attr": null,
          "required": false,
          "transform": "extract_percentage"
        },
        {
          "name": "volume_ml",
          "selector": ".text_widget h3 a",
          "attr": null,
          "required": false,
          "transform": "extract_volume_ml"
        },
        {
          "name": "price",
          "selector": ".pro_price .listed_price",
          "attr": null,
          "required": true,
          "transform": "clean_price"
        },
        {
          "name": "old_price",
          "selector": ".pro_price .sale_price",
          "attr": null,
          "required": false,
          "transform": "clean_price"
        },
        {
          "name": "stock_status",
          "selector": ".product_inner",
          "attr": null,
          "required": false,
          "transform": "check_for_sold_out_indicator"
        },
        {
          "name": "rating",
          "selector": ".product_inner",
          "attr": null,
          "required": false,
          "transform": "extract_rating_from_html_attributes_or_classes"
        },
        {
          "name": "review_count",
          "selector": ".product_inner",
          "attr": null,
          "required": false,
          "transform": "extract_review_count_from_html_attributes_or_classes"
        },
        {
          "name": "image_url",
          "selector": ".wrap_figure figure img",
          "attr": "data-lazy",
          "required": true,
          "transform": null
        },
        {
          "name": "product_url",
          "selector": ".wrap_figure figure a",
          "attr": "href",
          "required": true,
          "transform": null
        }
      ]
    },
    {
      "entity": "branches",
      "description": "List of store branches extracted from the footer.",
      "container_selector": "#fcl-chi_nhanh_toan_quoc",
      "item_selector": ".footer-content__link",
      "pagination": null,
      "fields": [
        {
          "name": "branch_name",
          "selector": "strong",
          "attr": null,
          "required": true,
          "transform": "text_content"
        },
        {
          "name": "branch_url",
          "selector": "a",
          "attr": "href",
          "required": false,
          "transform": null
        },
        {
          "name": "address",
          "selector": "li:nth-of-type(1)",
          "attr": null,
          "required": true,
          "transform": "text_content"
        },
        {
          "name": "phone",
          "selector": "li:nth-of-type(2) a[href^='tel']",
          "attr": null,
          "required": true,
          "transform": "text_content"
        },
        {
          "name": "email",
          "selector": "li:nth-of-type(3) a[href^='mailto']",
          "attr": null,
          "required": true,
          "transform": "text_content"
        }
      ]
    },
    {
      "entity": "company_profile",
      "description": "Company profile information, possibly related to official details or about us section.",
      "container_selector": "#fcl-security_1",
      "item_selector": ".footer-content__item",
      "pagination": null,
      "fields": [
        {
          "name": "company_name",
          "selector": "p:contains('Công ty TNHH Dịch Vụ và Thương Mại Toàn Thịnh')",
          "attr": null,
          "required": false,
          "transform": "text_content"
        },
        {
          "name": "company_address",
          "selector": "p:contains('Địa chỉ:')",
          "attr": null,
          "required": false,
          "transform": "text_content"
        },
        {
          "name": "company_phone",
          "selector": "p:contains('Góp ý')",
          "attr": null,
          "required": false,
          "transform": "text_content"
        },
        {
          "name": "company_email",
          "selector": "p:contains('Mail:')",
          "attr": null,
          "required": false,
          "transform": "text_content"
        },
        {
          "name": "company_logo",
          "selector": ".footer-content__item img[alt='ruoutot']",
          "attr": "data-src",
          "required": false,
          "transform": null
        }
      ]
    }
  ],
  "notes": "The provided HTML is for a homepage. Product and branch information is likely found on category or branch pages respectively. The 'products' crawl target is defined based on the 'qb_flash_sale' section, which might represent a subset of all products. Branch information is extracted from the footer. Company profile data is identified within the 'security_1' section in the footer."
}