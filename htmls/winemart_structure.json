{
  "source_file": "ruoutot.net_homepage",
  "page_type": "homepage",
  "crawl_targets": [
    {
      "entity": "products",
      "description": "Products are listed on the homepage in a flash sale section.",
      "container_selector": ".qb_flash_sale .wrap_fsale",
      "item_selector": ".item_fsale",
      "pagination": null,
      "fields": [
        {
          "name": "product_name",
          "selector": ".text_widget h3 a",
          "attr": null,
          "required": true,
          "transform": "strip_html"
        },
        {
          "name": "brand",
          "selector": ".text_widget h3 a",
          "attr": null,
          "required": false,
          "transform": "extract_brand_from_product_name"
        },
        {
          "name": "category",
          "selector": ".text_widget h3 a",
          "attr": null,
          "required": false,
          "transform": "extract_category_from_product_name"
        },
        {
          "name": "alcohol_percent",
          "selector": ".ha_alcohol",
          "attr": null,
          "required": false,
          "transform": "extract_percentage"
        },
        {
          "name": "volume_ml",
          "selector": ".text_widget h3 a",
          "attr": null,
          "required": false,
          "transform": "extract_volume_ml"
        },
        {
          "name": "price",
          "selector": ".pro_price .listed_price",
          "attr": null,
          "required": true,
          "transform": "clean_price"
        },
        {
          "name": "old_price",
          "selector": ".pro_price .sale_price",
          "attr": null,
          "required": false,
          "transform": "clean_price"
        },
        {
          "name": "stock_status",
          "selector": ".product_inner",
          "attr": null,
          "required": false,
          "transform": "check_for_sold_out_banner"
        },
        {
          "name": "rating",
          "selector": ".text_widget .rate i",
          "attr": null,
          "required": false,
          "transform": "count_star_ratings"
        },
        {
          "name": "review_count",
          "selector": ".text_widget .rate",
          "attr": null,
          "required": false,
          "transform": "extract_number_from_text"
        },
        {
          "name": "image_url",
          "selector": ".wrap_figure img",
          "attr": "data-lazy",
          "required": true,
          "transform": null
        },
        {
          "name": "product_url",
          "selector": ".wrap_figure a",
          "attr": "href",
          "required": true,
          "transform": null
        }
      ]
    },
    {
      "entity": "branches",
      "description": "Branches listed in the footer and also in a dedicated section.",
      "container_selector": ".qb_hethong_banhang .hethong_banhang_general .row",
      "item_selector": "div.col-sm-6",
      "pagination": null,
      "fields": [
        {
          "name": "branch_name",
          "selector": ".hethong_banhang_detailds h4",
          "attr": null,
          "required": true,
          "transform": null
        },
        {
          "name": "branch_url",
          "selector": ".hethong_banhang_detailds h4 a",
          "attr": "href",
          "required": false,
          "transform": null
        },
        {
          "name": "address",
          "selector": ".hethong_banhang_detailds ul li strong:first-child",
          "attr": null,
          "required": true,
          "transform": "strip_html"
        },
        {
          "name": "phone",
          "selector": ".hethong_banhang_detailds ul li strong a[href^='tel:']",
          "attr": null,
          "required": true,
          "transform": null
        },
        {
          "name": "email",
          "selector": ".hethong_banhang_detailds ul li strong a[href^='mailto:']",
          "attr": null,
          "required": false,
          "transform": null
        }
      ]
    },
    {
      "entity": "company_profile",
      "description": "Company information is present in the footer.",
      "container_selector": "#fcl-security_1",
      "item_selector": null,
      "pagination": null,
      "fields": [
        {
          "name": "company_name",
          "selector": "#fcl-security_1 .footer-content__item p:first-child",
          "attr": null,
          "required": true,
          "transform": null
        },
        {
          "name": "company_address",
          "selector": "#fcl-security_1 .footer-content__item p:last-child",
          "attr": null,
          "required": true,
          "transform": null
        },
        {
          "name": "company_phone",
          "selector": "#fcl-security_1 .footer-content__item p a[href^='tel:']",
          "attr": null,
          "required": false,
          "transform": null
        },
        {
          "name": "company_email",
          "selector": "#fcl-security_1 .footer-content__item p a[href^='mailto:']",
          "attr": null,
          "required": false,
          "transform": null
        },
        {
          "name": "company_logo",
          "selector": "#fcl-security_1 .footer-content__item img.footer-content__image",
          "attr": "data-src",
          "required": false,
          "transform": null
        }
      ]
    }
  ],
  "notes": "The HTML structure is quite complex. The product extraction targets the flash sale section. Branch extraction is done from a dedicated section that lists multiple store locations. Company profile information is found in the footer, specifically within a section with the ID 'fcl-security_1'. Some fields like brand and category are not directly present and would require extraction from product names."
}