# Dockerfile cho Backend Python
FROM python:3.11-slim

# Cài đặt system dependencies cho Admin Center API
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements và cài đặt dependencies
COPY infra/docker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Tạo user non-root
RUN useradd --create-home --shell /bin/bash app \
    && mkdir -p /app \
    && chown -R app:app /app

USER app

# Copy source code
# Copy source code (chỉ copy src/ và infra/)
COPY --chown=app:app src/ /app/src/
COPY --chown=app:app infra/ /app/infra/

# Standard import root
ENV PYTHONPATH=/app/src
ENV BACKEND_HOST=0.0.0.0
ENV BACKEND_PORT=8080

# Tạo thư mục cho store và logs
RUN mkdir -p /app/store /app/logs

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=10s --retries=3 \
    CMD curl -f "http://localhost:${BACKEND_PORT}/api/health" || exit 1

# Command để chạy
WORKDIR /app/src/apps/admin_center/backend
CMD ["sh", "-c", "uvicorn main:app --host ${BACKEND_HOST:-0.0.0.0} --port ${BACKEND_PORT:-8080}"]
