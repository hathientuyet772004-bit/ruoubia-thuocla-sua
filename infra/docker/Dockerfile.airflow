# Dockerfile cho Airflow — mở rộng từ image chính thức
# Cài thêm dependencies của collector backend (minio, redis, psycopg2, beautifulsoup4...)
FROM apache/airflow:2.9.2-python3.11

USER root

# Cài system deps cần thiết (lxml cần libxml2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Copy và cài requirements của dự án
COPY infra/airflow/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Copy collector backend vào image để DAG import được
COPY src/modules/collector/backend /opt/airflow/collector_backend
COPY src/shared /opt/airflow/shared

ENV PYTHONPATH=/opt/airflow
