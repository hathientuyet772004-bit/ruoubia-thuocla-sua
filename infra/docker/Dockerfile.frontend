# Dockerfile cho Frontend React
FROM node:18-alpine as builder

WORKDIR /app

# Copy package files
COPY src/apps/admin_center/frontend/package*.json ./

# Install dependencies
RUN npm ci && npm cache clean --force

# Copy source code
COPY src/apps/admin_center/frontend/ ./

# Build ứng dụng
RUN npm run build

# Runtime stage - serve with simple http server
FROM node:18-alpine

WORKDIR /app

# Cài đặt serve để chạy ứng dụng
RUN npm install -g serve

# Copy built files từ builder
COPY --from=builder /app/dist ./dist

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000 || exit 1

# Chạy ứng dụng
CMD ["serve", "-s", "dist", "-l", "3000"]
